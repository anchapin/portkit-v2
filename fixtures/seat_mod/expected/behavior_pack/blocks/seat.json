{
  "format_version": "1.20.20",
  "minecraft:block": {
    "description": {
      "identifier": "examplemod:seat",
      "menu_category": {
        "category": "construction"
      },
      "traits": {
        "minecraft:placement_direction": {
          "enabled_states": [
            "minecraft:cardinal_direction"
          ]
        }
      }
    },
    "components": {
      "minecraft:geometry": {
        "identifier": "geometry.examplemod.seat",
        "bone_visibility": {
          "facing_north": "q.block_state('minecraft:cardinal_direction') == 'north'",
          "facing_east": "q.block_state('minecraft:cardinal_direction') == 'east'",
          "facing_south": "q.block_state('minecraft:cardinal_direction') == 'south'",
          "facing_west": "q.block_state('minecraft:cardinal_direction') == 'west'"
        }
      },
      "minecraft:material_instances": {
        "*": {
          "render_method": "alpha_test",
          "texture": "examplemod:seat"
        }
      }
    }
  }
}
