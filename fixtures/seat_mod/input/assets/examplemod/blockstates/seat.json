{
  "multipart": [
    {
      "apply": {
        "model": "examplemod:block/seat"
      },
      "when": {
        "facing": "north"
      }
    },
    {
      "apply": {
        "model": "examplemod:block/seat",
        "y": 90
      },
      "when": {
        "facing": "east"
      }
    },
    {
      "apply": {
        "model": "examplemod:block/seat",
        "y": 180
      },
      "when": {
        "facing": "south"
      }
    },
    {
      "apply": {
        "model": "examplemod:block/seat",
        "y": 270
      },
      "when": {
        "facing": "west"
      }
    },
    {
      "apply": {
        "model": "examplemod:block/seat_post"
      },
      "when": {
        "attached": "true"
      }
    }
  ]
}
